# ─────────────────────────────────────────────────────────────────────────────
# Syscanner environment template.  Copy to `.env` for local development.
# NEVER commit a populated .env.  Production values come from a secret manager.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL (Prisma) ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://syscanner:syscanner@localhost:5432/syscanner?schema=public

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# ── Object storage for SARIF / SBOM / logs (S3-compatible) ───────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=syscanner-artifacts
S3_ACCESS_KEY_ID=syscanner
S3_SECRET_ACCESS_KEY=syscanner-local-dev
S3_FORCE_PATH_STYLE=true
# Artifacts are customer source material: keep retention short.
ARTIFACT_RETENTION_HOURS=72

# ── Auth (NextAuth / JWT) ────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# openssl rand -base64 48
NEXTAUTH_SECRET=replace-me-with-48-bytes-of-entropy
JWT_ISSUER=https://syscanner.local
JWT_AUDIENCE=syscanner-api

# ── API service ──────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# ── Envelope encryption / KMS (use a real KMS in production) ─────────────────
KMS_PROVIDER=local
KMS_LOCAL_MASTER_KEY=replace-me-32-byte-base64-master-key
KMS_KEY_ID=alias/syscanner-local

# ── SCM integrations (OAuth apps) ────────────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_WEBHOOK_SECRET=

# ── Sandbox execution ────────────────────────────────────────────────────────
SANDBOX_PROVIDER=docker            # docker | gvisor | kata | firecracker
SANDBOX_RUNTIME=runsc              # runtimeClass used by the orchestrator
SANDBOX_IMAGE_SAST=syscanner/sandbox-runner@sha256:REPLACE_WITH_DIGEST
SANDBOX_IMAGE_SECRETS=syscanner/sandbox-runner@sha256:REPLACE_WITH_DIGEST
SANDBOX_IMAGE_DEPS=syscanner/sandbox-runner@sha256:REPLACE_WITH_DIGEST
SANDBOX_CPUS=1.5
SANDBOX_MEMORY_MB=2048
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMPFS_MB=2048
SANDBOX_NETWORK=none               # never use host/bridge for untrusted code
SANDBOX_TIMEOUT_MS=600000
SANDBOX_CLONE_TIMEOUT_MS=120000
SANDBOX_TOOL_TIMEOUT_MS=300000
SANDBOX_MAX_REPO_MB=512
SANDBOX_MAX_FILES=50000
SANDBOX_MAX_FINDINGS=10000

# ── Worker tuning ────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4
WORKER_MAX_JOBS_PER_SANDBOX=1      # 1 job = 1 container, then destroy
