# Syscanner monorepo npm configuration
# Keep the strict isolated node_modules layout that pnpm uses by default.
node-linker=isolated

# Prisma and Next.js tooling expect to be resolvable from the workspace root.
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=*@prisma*

# Peer mismatches in a fast-moving monorepo should warn, not hard-fail installs.
auto-install-peers=true
strict-peer-dependencies=false

# Deterministic, lockfile-only CI installs.
resolution-mode=highest
save-exact=false

# Allow build scripts only for packages that genuinely need them (see root
# package.json "pnpm.onlyBuiltDependencies").
enable-pre-post-scripts=true
