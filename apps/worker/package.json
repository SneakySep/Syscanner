  },
  "dependencies": {
    "@syscanner/contracts": "workspace:*",
    "@syscanner/core": "workspace:*",
    "@syscanner/db": "workspace:*",
    "@syscanner/logger": "workspace:*",
    "@syscanner/queue": "workspace:*",
    "@syscanner/scanners": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@syscanner/testing": "workspace:*",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
